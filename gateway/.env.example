# N-ATLaS server (printed by the Kaggle notebook, step 5) and the key you set as UPSTREAM_KEY there
UPSTREAM_URL=https://example.trycloudflare.com
UPSTREAM_KEY=change-me
# Always-on CPU backup (Hugging Face Space running serving/cpu-backup) and its LLAMA_API_KEY
UPSTREAM_FALLBACK_URL=https://your-name-atlasbridge-cpu.hf.space
UPSTREAM_FALLBACK_KEY=change-me
FALLBACK_MAX_TOKENS=256
# Set to 1 to develop without a GPU (canned replies)
MOCK_UPSTREAM=0
# Postgres in production (e.g. Neon free tier); SQLite locally
DATABASE_URL=sqlite:///./atlasbridge.db
ADMIN_TOKEN=change-me-long-random
SIGNUP_CODE=naic-beta
RATE_LIMIT_PER_MINUTE=20
# Store 300-char previews of prompts/replies for validation evidence (tell testers if on)
LOG_CONTENT=1
CORS_ORIGINS=*
# Developer accounts (website + dashboard). Signs the session cookie: use a long random value.
SESSION_SECRET=change-me-long-random
# Mark the session cookie Secure even when TLS ends at a proxy (set to 1 in production)
SESSION_COOKIE_SECURE=0
# Account signup asks for SIGNUP_CODE while this is 1 and SIGNUP_CODE is set
ACCOUNT_SIGNUP_REQUIRE_CODE=1
MAX_KEYS_PER_USER=5
AUTH_ATTEMPTS_PER_15_MIN=10
